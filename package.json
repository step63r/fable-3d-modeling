{
  "name": "fable-3d-modeling",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "assets:fetch": "node tools/fetch-assets.mjs",
    "assets:build": "node tools/build-assets.mjs",
    "assets": "node tools/fetch-assets.mjs && node tools/build-assets.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "screenshot": "node tools/screenshot.mjs"
  },
  "dependencies": {
    "three": "^0.187.0",
    "three-gpu-pathtracer": "^0.0.28",
    "three-mesh-bvh": "^0.9.18"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
